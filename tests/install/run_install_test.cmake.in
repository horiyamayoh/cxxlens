set(test_root "@CMAKE_CURRENT_BINARY_DIR@/install-consumer")
set(install_prefix "${test_root}/relocated-prefix")
set(install_libdir "@CMAKE_INSTALL_LIBDIR@")
set(artifact_manifest "${test_root}/install-artifact-manifest.json")
set(artifact_configuration
    "shared=@CXXLENS_BUILD_SHARED@,build_type=@CMAKE_BUILD_TYPE@,asan=@CXXLENS_ENABLE_ASAN@,ubsan=@CXXLENS_ENABLE_UBSAN@,tsan=@CXXLENS_ENABLE_TSAN@"
)

if(NOT DEFINED PHASE)
  message(FATAL_ERROR "install test requires an explicit PHASE")
endif()

set(cxxlens_clang22_available "@CXXLENS_CLANG22_AVAILABLE@")
set(cxxlens_clang22_adapter "@CXXLENS_CLANG_ADAPTER@")
set(cxxlens_clang22_unavailable_reason "@CXXLENS_CLANG22_UNAVAILABLE_REASON@")
set(install_executable_suffix "@CMAKE_EXECUTABLE_SUFFIX@")
set(install_executable_names
    cxxlens-provider-scaffold cxxlens-sdk-doctor cxxlens-clang-worker-22
    cxxlens-clang22-materialize)
set(artifact_source_arguments --source-revision "@CXXLENS_SOURCE_REVISION@"
                              --source-tree "@CXXLENS_SOURCE_TREE@")

# These phases are the installed native-provider qualification boundary.  An
# AUTO/OFF structured-unavailable build remains useful for the portable SDK and
# its unavailable-mode consumers, but it must not enter a native positive or
# negative evidence run and later look like a provider failure.
if(PHASE MATCHES "^clang22-materializer-(success|base64|negative)$"
   AND NOT "${cxxlens_clang22_available}" STREQUAL "TRUE")
  message(
    FATAL_ERROR
      "installed Clang 22 qualification is unavailable before execution: adapter=${cxxlens_clang22_adapter}, reason=${cxxlens_clang22_unavailable_reason}; configure a clean build with CXXLENS_CLANG_ADAPTER=ON and an exact LLVM_DIR/Clang package, then rerun this phase. No native evidence was produced."
  )
endif()

function(run_clean expected_result)
  execute_process(
    COMMAND "@CMAKE_COMMAND@" -E env --unset=LD_LIBRARY_PATH
            --unset=DYLD_LIBRARY_PATH ${ARGN}
    RESULT_VARIABLE actual_result
    OUTPUT_VARIABLE command_output
    ERROR_VARIABLE command_error)
  if(NOT actual_result EQUAL expected_result)
    message(
      FATAL_ERROR
        "installed command failed (${actual_result}, expected ${expected_result}): ${ARGN}\nstdout: ${command_output}\nstderr: ${command_error}"
    )
  endif()
endfunction()

function(write_sdk_doctor_capability_fixture fixture_path)
  file(
    WRITE "${fixture_path}"
    [=[{
  "schema": "cxxlens.agent-capability-resolution.v1",
  "use_case": "installed.demo.v1",
  "capability_path": [
    {"id": "input.source", "kind": "input", "state": "proved"},
    {"id": "provider.semantic", "kind": "provider", "state": "unknown",
     "requires": ["input.source"], "reason_code": "provider.missing",
     "owner_issue": "#261", "action": "install-provider"},
    {"id": "recipe.explain", "kind": "recipe", "state": "proved",
     "requires": ["provider.semantic"]}
  ]
}
]=])
endfunction()

function(resolve_install_artifact_path canonical_path resolved_path)
  set(resolved "${canonical_path}")
  foreach(executable IN LISTS install_executable_names)
    if("${canonical_path}" STREQUAL "${install_prefix}/bin/${executable}")
      string(APPEND resolved "${install_executable_suffix}")
      break()
    endif()
  endforeach()
  set(${resolved_path}
      "${resolved}"
      PARENT_SCOPE)
endfunction()

function(run_installed_tools label)
  set(doctored_project "${test_root}/sdk-doctor-${label}.json")
  set(doctored_report "${test_root}/sdk-doctor-${label}.report.json")
  write_sdk_doctor_capability_fixture("${doctored_project}")
  run_clean(
    0 "${install_prefix}/bin/cxxlens-sdk-doctor${install_executable_suffix}"
    inspect)
  run_clean(
    0 "${install_prefix}/bin/cxxlens-sdk-doctor${install_executable_suffix}"
    capability installed.demo.v1 --project "${doctored_project}")
  run_clean(
    0
    "${install_prefix}/bin/cxxlens-sdk-doctor${install_executable_suffix}"
    capability
    installed.demo.v1
    --project
    "${doctored_project}"
    --format
    markdown)
  run_clean(
    0 "${install_prefix}/bin/cxxlens-sdk-doctor${install_executable_suffix}"
    missing --project "${doctored_project}")
  execute_process(
    COMMAND
      "@CMAKE_COMMAND@" -E env --unset=LD_LIBRARY_PATH --unset=DYLD_LIBRARY_PATH
      "${install_prefix}/bin/cxxlens-sdk-doctor${install_executable_suffix}"
      capability installed.demo.v1 --project "${doctored_project}"
    OUTPUT_FILE "${doctored_report}"
    RESULT_VARIABLE doctor_report_result)
  if(NOT doctor_report_result EQUAL 0)
    message(
      FATAL_ERROR
        "installed sdk-doctor capability report failed: ${doctor_report_result}"
    )
  endif()
  execute_process(
    COMMAND
      "@Python3_EXECUTABLE@"
      "@CMAKE_CURRENT_SOURCE_DIR@/install/check_sdk_doctor_installed_consumer.py"
      "${install_prefix}/bin/cxxlens-sdk-doctor${install_executable_suffix}"
    COMMAND_ERROR_IS_FATAL ANY)
  run_clean(
    0 "${install_prefix}/bin/cxxlens-sdk-doctor${install_executable_suffix}"
    explain "${doctored_report}")
  run_clean(
    1
    "${install_prefix}/bin/cxxlens-clang-worker-22${install_executable_suffix}")
  set(scaffold_output "${test_root}/scaffold-${label}")
  file(REMOVE_RECURSE "${scaffold_output}")
  run_clean(
    0
    "${install_prefix}/bin/cxxlens-provider-scaffold${install_executable_suffix}"
    "${scaffold_output}"
    company.install.provider
    portable
    company.install.relation)
endfunction()

if(PHASE STREQUAL "prepare")
  file(REMOVE_RECURSE "${test_root}")
  set(staging_prefix "${test_root}/prefix")
  set(install_prefix "${staging_prefix}")
  execute_process(
    COMMAND "@CMAKE_COMMAND@" --build "@CMAKE_BINARY_DIR@" --target
            cxxlens-clang22-materialize COMMAND_ERROR_IS_FATAL ANY)
  # `cmake --install` does not build targets, and the public Clang 22 SDK DSO
  # plus the installed worker are not dependencies of the materializer binary.
  # Build the complete installed executable/DSO closure before staging it.
  execute_process(
    COMMAND
      "@CMAKE_COMMAND@" --build "@CMAKE_BINARY_DIR@" --target
      cxxlens-provider-scaffold cxxlens-sdk-doctor cxxlens-clang-worker-22
      cxxlens_clang22_provider_sdk COMMAND_ERROR_IS_FATAL ANY)
  execute_process(
    COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@" --prefix
            "${install_prefix}" COMMAND_ERROR_IS_FATAL ANY)

  # Keep canonical artifact paths literal for the installed-surface census. Only
  # the filesystem path used by the existence check receives the platform
  # executable suffix.
  foreach(
    required IN
    ITEMS
      "${install_prefix}/include/cxxlens/cxxlens.hpp"
      "${install_prefix}/include/cxxlens/sdk.hpp"
      "${install_prefix}/include/cxxlens/sdk/query.hpp"
      "${install_prefix}/include/cxxlens/provider/clang22.hpp"
      "${install_prefix}/include/cxxlens/relations/cc_call_site.hpp"
      "${install_prefix}/include/cxxlens/relations/cc_declaration.hpp"
      "${install_prefix}/include/cxxlens/relations/cc_type_component.hpp"
      "${install_prefix}/include/cxxlens/relations/core_provider_execution.hpp"
      "${install_prefix}/include/cxxlens/relations/core_unresolved.hpp"
      "${install_prefix}/include/cxxlens/relations/core_claim_conflict.hpp"
      "${install_prefix}/include/cxxlens/relations/core_differential_disagreement.hpp"
      "${install_prefix}/include/cxxlens/relations/source_origin.hpp"
      "${install_prefix}/${install_libdir}/cmake/cxxlens/cxxlensConfig.cmake"
      "${install_prefix}/${install_libdir}/cmake/cxxlensProviderSDK/cxxlensProviderSDKConfig.cmake"
      "${install_prefix}/${install_libdir}/cmake/cxxlensClang22ProviderSDK/cxxlensClang22ProviderSDKConfig.cmake"
      "${install_prefix}/share/cxxlens/schemas/cxxlens_ng_public_api_catalog.yaml"
      "${install_prefix}/share/cxxlens/schemas/cxxlens_ng_agent_autonomous_completion_metric.schema.yaml"
      "${install_prefix}/share/cxxlens/schemas/cxxlens_ng_clang22_materialization_contract.yaml"
      "${install_prefix}/share/cxxlens/schemas/cxxlens_ng_clang22_materialization_contract.schema.yaml"
      "${install_prefix}/share/cxxlens/schemas/cxxlens_ng_clang22_materialization_request.schema.yaml"
      "${install_prefix}/share/cxxlens/schemas/cxxlens_ng_clang22_materialization_report.schema.yaml"
      "${install_prefix}/share/cxxlens/schemas/cxxlens_ng_clang22_materializer_occurrence_manifest.schema.yaml"
      "${install_prefix}/share/doc/cxxlens/LICENSE"
      "${install_prefix}/share/doc/cxxlens/NOTICE"
      "${install_prefix}/bin/cxxlens-provider-scaffold"
      "${install_prefix}/bin/cxxlens-sdk-doctor"
      "${install_prefix}/bin/cxxlens-clang-worker-22"
      "${install_prefix}/bin/cxxlens-clang22-materialize")
    resolve_install_artifact_path("${required}" resolved_required)
    if(NOT EXISTS "${resolved_required}")
      message(
        FATAL_ERROR
          "installed next-generation artifact is missing: ${resolved_required}")
    endif()
  endforeach()

  run_installed_tools(original)

  return()
endif()

if(PHASE STREQUAL "relocation")
  file(RENAME "${test_root}/prefix" "${install_prefix}")
  run_installed_tools(relocated)
  execute_process(
    COMMAND
      "@Python3_EXECUTABLE@"
      "@CMAKE_CURRENT_SOURCE_DIR@/../tools/quality/install_artifact_manifest.py"
      create --root "@CMAKE_CURRENT_SOURCE_DIR@/.."
      ${artifact_source_arguments} --prefix "${install_prefix}" --compiler
      "@CMAKE_CXX_COMPILER@" --configuration "${artifact_configuration}"
      --manifest "${artifact_manifest}" COMMAND_ERROR_IS_FATAL ANY)
  return()
endif()

execute_process(
  COMMAND
    "@Python3_EXECUTABLE@"
    "@CMAKE_CURRENT_SOURCE_DIR@/../tools/quality/install_artifact_manifest.py"
    verify --root "@CMAKE_CURRENT_SOURCE_DIR@/.." ${artifact_source_arguments}
    --prefix "${install_prefix}" --compiler "@CMAKE_CXX_COMPILER@"
    --configuration "${artifact_configuration}" --manifest
    "${artifact_manifest}" COMMAND_ERROR_IS_FATAL ANY)

if(PHASE STREQUAL "shared-runtime-layout")
  if(NOT "@CXXLENS_BUILD_SHARED@" STREQUAL "ON")
    return()
  endif()
  set(layout_prefix "${test_root}/layout-prefix")
  file(REMOVE_RECURSE "${layout_prefix}")
  file(COPY "${install_prefix}/" DESTINATION "${layout_prefix}")
  set(install_prefix "${layout_prefix}")
endif()

if(PHASE STREQUAL "shared-runtime-layout"
   AND UNIX
   AND NOT APPLE)
  find_program(CXXLENS_READELF NAMES readelf llvm-readelf REQUIRED)
  foreach(tool IN ITEMS cxxlens-provider-scaffold cxxlens-sdk-doctor
                        cxxlens-clang-worker-22 cxxlens-clang22-materialize)
    execute_process(
      COMMAND "${CXXLENS_READELF}" -d
              "${install_prefix}/bin/${tool}${install_executable_suffix}"
      OUTPUT_VARIABLE dynamic_section COMMAND_ERROR_IS_FATAL ANY)
    if(NOT dynamic_section MATCHES "RUNPATH.*\\$ORIGIN/../${install_libdir}")
      message(FATAL_ERROR "installed tool lacks relocatable RUNPATH: ${tool}")
    endif()
    if(dynamic_section MATCHES "@CMAKE_BINARY_DIR@")
      message(FATAL_ERROR "installed tool retains build-tree path: ${tool}")
    endif()
  endforeach()
  file(GLOB base_libraries
       "${install_prefix}/${install_libdir}/libcxxlens_base.so.*")
  if(NOT base_libraries)
    message(FATAL_ERROR "shared package lacks versioned cxxlens base library")
  endif()
  list(GET base_libraries 0 base_library)
  execute_process(
    COMMAND "${CXXLENS_READELF}" -d "${base_library}"
    OUTPUT_VARIABLE library_dynamic_section COMMAND_ERROR_IS_FATAL ANY)
  if(NOT library_dynamic_section MATCHES "SONAME.*libcxxlens_base.so.1")
    message(FATAL_ERROR "shared library SONAME does not bind project major")
  endif()
  if(NOT library_dynamic_section MATCHES "RUNPATH.*\\$ORIGIN")
    message(
      FATAL_ERROR "shared library lacks same-directory relocatable RUNPATH")
  endif()
  if(library_dynamic_section MATCHES "@CMAKE_BINARY_DIR@")
    message(FATAL_ERROR "installed library retains build-tree path")
  endif()

  set(base_soname "${install_prefix}/${install_libdir}/libcxxlens_base.so.1")
  set(base_soname_unavailable "${base_soname}.unavailable")
  if(NOT EXISTS "${base_soname}")
    message(FATAL_ERROR "shared package lacks the cxxlens base SONAME link")
  endif()
  file(RENAME "${base_soname}" "${base_soname_unavailable}")
  execute_process(
    COMMAND
      "@CMAKE_COMMAND@" -E env --unset=LD_LIBRARY_PATH --unset=DYLD_LIBRARY_PATH
      "${install_prefix}/bin/cxxlens-sdk-doctor${install_executable_suffix}"
      inspect
    RESULT_VARIABLE missing_dependency_result
    OUTPUT_VARIABLE missing_dependency_output
    ERROR_VARIABLE missing_dependency_error)
  file(RENAME "${base_soname_unavailable}" "${base_soname}")
  if(missing_dependency_result EQUAL 0)
    message(FATAL_ERROR "installed tool ignored a missing shared dependency")
  endif()
  if(NOT missing_dependency_error MATCHES "libcxxlens_base\\.so\\.1")
    message(
      FATAL_ERROR
        "missing shared dependency diagnostic lacks the SONAME: ${missing_dependency_error}"
    )
  endif()
endif()

if(PHASE STREQUAL "shared-runtime-layout" AND WIN32)
  # Windows shared targets have two install artifacts: the import library stays
  # in the archive directory, while the DLL runtime must be beside installed
  # executables. This check is intentionally limited to layout; it is not a
  # Windows/MSVC qualification claim.
  foreach(library IN
          ITEMS cxxlens_base cxxlens_kernel cxxlens_query cxxlens_recipes
                cxxlens_provider_sdk cxxlens_clang22_provider_sdk)
    file(
      GLOB
      runtime_artifacts
      "${install_prefix}/bin/@CMAKE_SHARED_LIBRARY_PREFIX@${library}@CMAKE_SHARED_LIBRARY_SUFFIX@*"
    )
    list(LENGTH runtime_artifacts runtime_artifact_count)
    if(NOT runtime_artifact_count EQUAL 1)
      message(
        FATAL_ERROR
          "shared package must contain exactly one Windows DLL runtime (${library}), found ${runtime_artifact_count}"
      )
    endif()
    file(
      GLOB
      import_artifacts
      "${install_prefix}/${install_libdir}/@CMAKE_IMPORT_LIBRARY_PREFIX@${library}@CMAKE_IMPORT_LIBRARY_SUFFIX@*"
    )
    list(LENGTH import_artifacts import_artifact_count)
    if(NOT import_artifact_count EQUAL 1)
      message(
        FATAL_ERROR
          "shared package must contain exactly one Windows import library (${library}), found ${import_artifact_count}"
      )
    endif()
  endforeach()
endif()

if(PHASE STREQUAL "shared-runtime-layout")
  return()
endif()

if(PHASE STREQUAL "clang22-materializer-success")
  set(materialization_evidence_dir "${test_root}/materialization-evidence")
  file(REMOVE_RECURSE "${materialization_evidence_dir}")
  foreach(materialization_backend IN ITEMS memory sqlite)
    execute_process(
      COMMAND
        "@Python3_EXECUTABLE@"
        "@CMAKE_CURRENT_SOURCE_DIR@/install/clang22_materializer_success_test.py"
        --root "@CMAKE_CURRENT_SOURCE_DIR@/.." --prefix "${install_prefix}"
        --executable-suffix "${install_executable_suffix}" --backend
        "${materialization_backend}" --translation-unit-count 2 --evidence-dir
        "${materialization_evidence_dir}" COMMAND_ERROR_IS_FATAL ANY)
  endforeach()
  execute_process(
    COMMAND
      "@Python3_EXECUTABLE@"
      "@CMAKE_CURRENT_SOURCE_DIR@/../tools/quality/check_ng_clang22_install_matrix.py"
      --root "@CMAKE_CURRENT_SOURCE_DIR@/.." --evidence-dir
      "${materialization_evidence_dir}" --output
      "${materialization_evidence_dir}/configuration-evidence.json" --prefix
      "${install_prefix}" --executable-suffix "${install_executable_suffix}"
      COMMAND_ERROR_IS_FATAL ANY)
  message(STATUS "installed Clang 22 evidence: ${materialization_evidence_dir}")
  return()
endif()

if(PHASE STREQUAL "clang22-materializer-base64")
  foreach(materialization_backend IN ITEMS memory sqlite)
    execute_process(
      COMMAND
        "@Python3_EXECUTABLE@"
        "@CMAKE_CURRENT_SOURCE_DIR@/install/clang22_materializer_success_test.py"
        --root "@CMAKE_CURRENT_SOURCE_DIR@/.." --prefix "${install_prefix}"
        --executable-suffix "${install_executable_suffix}" --backend
        "${materialization_backend}" --translation-unit-count 2
        --canonical-base64-vectors COMMAND_ERROR_IS_FATAL ANY)
  endforeach()
  return()
endif()

if(PHASE STREQUAL "clang22-materializer-negative")
  set(materialization_negative_evidence_dir
      "${test_root}/materialization-negative-evidence")
  file(REMOVE_RECURSE "${materialization_negative_evidence_dir}")
  execute_process(
    COMMAND
      "@Python3_EXECUTABLE@"
      "@CMAKE_CURRENT_SOURCE_DIR@/install/clang22_materializer_negative_test.py"
      --root "@CMAKE_CURRENT_SOURCE_DIR@/.." --prefix "${install_prefix}"
      --executable-suffix "${install_executable_suffix}" --evidence-dir
      "${materialization_negative_evidence_dir}" COMMAND_ERROR_IS_FATAL ANY)
  message(
    STATUS
      "installed Clang 22 negative evidence: ${materialization_negative_evidence_dir}"
  )
  return()
endif()

if(PHASE STREQUAL "legacy-zero")
  foreach(
    forbidden IN
    ITEMS
      "${install_prefix}/include/cxxlens/facts.hpp"
      "${install_prefix}/include/cxxlens/select.hpp"
      "${install_prefix}/include/cxxlens/workspace.hpp"
      "${install_prefix}/include/cxxlens/interop/clang.hpp"
      "${install_prefix}/bin/cxxlens-frontend-worker${install_executable_suffix}"
      "${install_prefix}/share/cxxlens/schemas/cxxlens_public_api_contract.yaml"
      "${install_prefix}/share/cxxlens/schemas/cxxlens_m2_completion.yaml")
    if(EXISTS "${forbidden}")
      message(FATAL_ERROR "legacy artifact was installed: ${forbidden}")
    endif()
  endforeach()
  return()
endif()

if(PHASE STREQUAL "real-project-incompatible-version")
  set(negative_build_dir "${test_root}/real-project-incompatible-build")
  file(REMOVE_RECURSE "${negative_build_dir}")
  execute_process(
    COMMAND
      "@CMAKE_COMMAND@" -S
      "@CMAKE_CURRENT_SOURCE_DIR@/install/real_project_consumer" -B
      "${negative_build_dir}" "-DCMAKE_PREFIX_PATH=${install_prefix}"
      "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@"
      "-DCXXLENS_REQUIRE_INCOMPATIBLE_VERSION=ON"
    RESULT_VARIABLE incompatible_result
    OUTPUT_QUIET ERROR_QUIET)
  if(incompatible_result EQUAL 0)
    message(
      FATAL_ERROR "real project accepted an incompatible distribution major")
  endif()
  return()
endif()

if(PHASE MATCHES "^(core|sdk|clang22-sdk|real-project)-consumer$")
  if(PHASE STREQUAL "core-consumer")
    set(consumer consumer)
  elseif(PHASE STREQUAL "sdk-consumer")
    set(consumer sdk_consumer)
  elseif(PHASE STREQUAL "real-project-consumer")
    set(consumer real_project_consumer)
  else()
    set(consumer clang22_sdk_consumer)
  endif()
  set(build_dir "${test_root}/${consumer}-build")
  file(REMOVE_RECURSE "${build_dir}")
  execute_process(
    COMMAND
      "@CMAKE_COMMAND@" -S "@CMAKE_CURRENT_SOURCE_DIR@/install/${consumer}" -B
      "${build_dir}" "-DCMAKE_PREFIX_PATH=${install_prefix}"
      "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@" "-DLLVM_DIR=@LLVM_DIR@"
      "-DClang_DIR=@Clang_DIR@" "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      "-DCXXLENS_ENABLE_ASAN=@CXXLENS_ENABLE_ASAN@"
      "-DCXXLENS_ENABLE_UBSAN=@CXXLENS_ENABLE_UBSAN@"
      "-DCXXLENS_ENABLE_TSAN=@CXXLENS_ENABLE_TSAN@" COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "@CMAKE_COMMAND@" --build "${build_dir}"
                          COMMAND_ERROR_IS_FATAL ANY)
  string(REPLACE "_" "-" consumer_executable "${consumer}")
  run_clean(
    0 "${build_dir}/cxxlens-${consumer_executable}${install_executable_suffix}")
  set(consumer_prefix "${test_root}/${consumer}-prefix")
  execute_process(COMMAND "@CMAKE_COMMAND@" --install "${build_dir}" --prefix
                          "${consumer_prefix}" COMMAND_ERROR_IS_FATAL ANY)
  run_clean(
    0
    "${consumer_prefix}/bin/cxxlens-${consumer_executable}${install_executable_suffix}"
  )
  return()
endif()

if(PHASE STREQUAL "examples-consumer")
  set(example_build_dir "${test_root}/examples-consumer-build")
  file(REMOVE_RECURSE "${example_build_dir}")
  execute_process(
    COMMAND
      "@CMAKE_COMMAND@" -S
      "@CMAKE_CURRENT_SOURCE_DIR@/install/examples_consumer" -B
      "${example_build_dir}" "-DCMAKE_PREFIX_PATH=${install_prefix}"
      "-DCXXLENS_EXAMPLE_ROOT=${install_prefix}/share/doc/cxxlens/examples/sdk"
      "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@" "-DLLVM_DIR=@LLVM_DIR@"
      "-DClang_DIR=@Clang_DIR@" "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      "-DCXXLENS_ENABLE_ASAN=@CXXLENS_ENABLE_ASAN@"
      "-DCXXLENS_ENABLE_UBSAN=@CXXLENS_ENABLE_UBSAN@"
      "-DCXXLENS_ENABLE_TSAN=@CXXLENS_ENABLE_TSAN@" COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "@CMAKE_COMMAND@" --build "${example_build_dir}"
                          COMMAND_ERROR_IS_FATAL ANY)
  set(example_prefix "${test_root}/examples-consumer-prefix")
  execute_process(
    COMMAND "@CMAKE_COMMAND@" --install "${example_build_dir}" --prefix
            "${example_prefix}" COMMAND_ERROR_IS_FATAL ANY)
  foreach(example IN ITEMS recipe typed_query dynamic_query portable_provider
                           clang22-native)
    run_clean(
      0
      "${example_build_dir}/cxxlens-installed-${example}${install_executable_suffix}"
    )
    run_clean(
      0
      "${example_prefix}/bin/cxxlens-installed-${example}${install_executable_suffix}"
    )
  endforeach()
  return()
endif()

message(FATAL_ERROR "unknown install test PHASE: ${PHASE}")
