+		struct pipe_write_result
+		{
+			ssize_t count{-1};
+			int error{};
+		};
+
+		/**
+		 * A pipe write generates SIGPIPE for the calling thread before returning EPIPE.  Block it
+		 * only around the write, consume only a signal generated by this write, and restore the
+		 * caller's mask so the provider boundary cannot change process-wide signal semantics.
+		 */
+		[[nodiscard]] pipe_write_result write_without_sigpipe(const int destination,
+													 const void* const bytes,
+													 const std::size_t size) noexcept
+		{
+			sigset_t blocked{};
+			if (::sigemptyset(&blocked) != 0 || ::sigaddset(&blocked, SIGPIPE) != 0)
+				return {-1, errno};
+			sigset_t previous{};
+			const auto block_error = ::pthread_sigmask(SIG_BLOCK, &blocked, &previous);
+			if (block_error != 0)
+				return {-1, block_error};
+
+			sigset_t pending{};
+			if (::sigpending(&pending) != 0)
+			{
+				const auto pending_error = errno;
+				(void)::pthread_sigmask(SIG_SETMASK, &previous, nullptr);
+				return {-1, pending_error};
+			}
+			const auto already_pending = ::sigismember(&pending, SIGPIPE);
+			if (already_pending < 0)
+			{
+				const auto pending_error = errno;
+				(void)::pthread_sigmask(SIG_SETMASK, &previous, nullptr);
+				return {-1, pending_error};
+			}
+
+			const auto count = ::write(destination, bytes, size);
+			const auto write_error = count < 0 ? errno : 0;
+			if (count < 0 && write_error == EPIPE && already_pending == 0)
+			{
+				sigset_t generated{};
+				if (::sigpending(&generated) == 0 && ::sigismember(&generated, SIGPIPE) == 1)
+				{
+					const timespec no_wait{};
+					while (::sigtimedwait(&blocked, nullptr, &no_wait) < 0 && errno == EINTR)
+					{
+					}
+				}
+			}
+			(void)::pthread_sigmask(SIG_SETMASK, &previous, nullptr);
+			return {count, write_error};
+		}
+
