@@ -131,7 +131,63 @@ int main(const int argument_count, const char* const* arguments)
 	if (argument_count != 2)
 		return EXIT_FAILURE;
 	const std::string_view mode{arguments[1]};
+#if defined(__linux__) && defined(__GLIBC__)
+	if (mode == "ng1-output-before-input")
+	{
+		const std::string output(4U * 1024U * 1024U, 'x');
+		std::cout.write(output.data(), static_cast<std::streamsize>(output.size()));
+		std::cout.flush();
+		if (!std::cout.good())
+			return EXIT_FAILURE;
+		const std::string ignored{std::istreambuf_iterator<char>{std::cin},
+								  std::istreambuf_iterator<char>{}};
+		return std::cin.bad() ? EXIT_FAILURE : EXIT_SUCCESS;
+	}
+
+	constexpr std::string_view close_input_prefix = "ng1-close-input:";
+	if (mode.starts_with(close_input_prefix))
+	{
+		const auto marker_path = mode.substr(close_input_prefix.size());
+		if (marker_path.empty() || ::close(STDIN_FILENO) != 0)
+			return EXIT_FAILURE;
+		std::ofstream marker{std::string{marker_path}, std::ios::trunc};
+		marker << "ready\n";
+		marker.close();
+		if (!marker)
+			return EXIT_FAILURE;
+		std::this_thread::sleep_for(std::chrono::seconds{5});
+		return EXIT_SUCCESS;
+	}
+
+	constexpr std::string_view exited_leader_prefix = "ng1-exited-leader-descendant:";
+	if (mode.starts_with(exited_leader_prefix))
+	{
+		const auto marker_path = mode.substr(exited_leader_prefix.size());
+		if (marker_path.empty())
+			return EXIT_FAILURE;
+		const auto descendant = ::fork();
+		if (descendant < 0)
+			return EXIT_FAILURE;
+		if (descendant == 0)
+		{
+			(void)::close(STDIN_FILENO);
+			const auto start_time = process_start_time();
+			if (!start_time)
+				::_exit(EXIT_FAILURE);
+			std::ofstream marker{std::string{marker_path}, std::ios::trunc};
+			marker << ::getpid() << ' ' << *start_time << '\n';
+			marker.close();
+			if (!marker)
+				::_exit(EXIT_FAILURE);
+			std::this_thread::sleep_for(std::chrono::seconds{5});
+			::_exit(EXIT_SUCCESS);
+		}
+		return EXIT_SUCCESS;
+	}
+#endif
 	std::string input{std::istreambuf_iterator<char>{std::cin}, std::istreambuf_iterator<char>{}};
+	if (mode == "ng1-drain-input")
+		return std::cin.bad() ? EXIT_FAILURE : EXIT_SUCCESS;
 	std::vector<std::byte> bytes;
 	bytes.reserve(input.size());
 	for (const auto byte : input)
